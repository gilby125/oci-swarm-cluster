terraform {
  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.0"
    }
  }
}

provider "cloudflare" {
  api_token = var.cloudflare_api_token != "" ? var.cloudflare_api_token : "dummy_token_not_used_1234567890abcdefghijklmnopqrstuvwxyz"
}

locals {
  use_cloudflare = var.cloudflare_email != "" && var.cloudflare_api_token != "" && var.domain_name != ""
  dns_records = local.use_cloudflare ? [
    "dev-oci",
    "local",
    "local-version",
    "registry",
    "registry-version",
    "portainer-version",
    "admin-pangolin"
  ] : []
}

# Only create Cloudflare resources if credentials are provided
data "cloudflare_zone" "domain" {
  count = local.use_cloudflare ? 1 : 0
  name  = var.domain_name
}

resource "cloudflare_record" "dns_records" {
  for_each = local.use_cloudflare ? toset(local.dns_records) : []

  zone_id = data.cloudflare_zone.domain[0].id
  name    = each.value
  content = oci_load_balancer_load_balancer.oci_swarm_lb.ip_address_details[0].ip_address
  type    = "A"
  ttl     = 1
  proxied = true
}
